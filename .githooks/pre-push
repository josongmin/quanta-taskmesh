#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"
platform_receipt="target/verification/macos-gates.json"
full_receipt="target/qualification/local-receipt.json"
zero="0000000000000000000000000000000000000000"

checked=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # Git permits a detached checkout to update a branch with `HEAD:main`.
  # Classify the update by its destination; classifying by the local spelling
  # lets that branch update bypass the exact-HEAD receipt check.
  case "${remote_ref}" in
    refs/heads/*)
      if [[ "${local_sha}" == "${zero}" ]]; then
        continue
      fi
      if [[ "$(git rev-parse HEAD)" != "${local_sha}" ]]; then
        echo "pre-push: branch update must point at the currently verified HEAD" >&2
        exit 1
      fi
      if [[ -f "${full_receipt}" ]] && uv run python tools/qualification/receipt.py \
        validate "${full_receipt}"; then
        checked=1
        continue
      fi
      uv run python tools/gates/run.py \
        --validate-receipt "${platform_receipt}" \
        --expected-head "${local_sha}"
      checked=1
      ;;
  esac
done

if [[ "${checked}" -eq 0 ]]; then
  echo "pre-push: no branch update requires a local verification receipt"
fi
