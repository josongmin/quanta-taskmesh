# Rust build artifacts
/target/
# The out-of-workspace MSRV consumer fixture builds into its own target dir.
/tools/consumer-msrv/target/

# Lockfile is committed for reproducible CI/bench (workspace root).
# Do not add: Cargo.lock

# Python (uv, pytest, ruff, tools/pm)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local benchmark / measurement output (regenerate via just bench-*)
bench-results/

# Profiling / coverage OUTPUT (local only). Anchored: an unanchored `coverage/`
# also matched tools/coverage/ and kept the coverage-report gate's script out of
# git (CI could not run it). The gate validator now refuses any recipe script
# git does not track.
*.profraw
/coverage/
/llvm-cov/

# Optional local semgrep cache
.semgrep/

# Compiler crash dumps are never source.
rustc-ice-*.txt

# Agent worktrees are scratch checkouts, never part of the source.
.claude/worktrees/

# A qualification receipt describes the source; it is not part of it. `collect`
# writes <out>, <out>.gates.json and <out>.mutations.json, and CI writes them
# at the repository root — ignored, so they are outside both the identity
# digest and the dirtiness check they would otherwise invalidate.
/receipt*.json
# proptest writes a regression seed file next to a failing property test.
*.proptest-regressions
