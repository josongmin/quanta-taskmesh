# Rust build artifacts
/target/
# The out-of-workspace MSRV consumer fixture builds into its own target dir.
/tools/consumer-msrv/target/

# Lockfile is committed for reproducible CI/bench (workspace root).
# Do not add: Cargo.lock

# Python (uv, pytest, ruff, tools/pm)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local benchmark / measurement output (regenerate via just bench-*)
bench-results/

# Profiling / coverage (local only)
*.profraw
coverage/
llvm-cov/

# Optional local semgrep cache
.semgrep/

# Compiler crash dumps are never source.
rustc-ice-*.txt

# Agent worktrees are scratch checkouts, never part of the source.
.claude/worktrees/
