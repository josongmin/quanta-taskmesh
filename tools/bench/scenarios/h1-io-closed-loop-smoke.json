{
  "schema_version": 1,
  "id": "h1-io-closed-loop-smoke-v1",
  "warmup_ms": 2,
  "max_run_ms": 500,
  "settlement_ms": 500,
  "concurrency": 2,
  "iterations_per_slot": 3,
  "topology": {
    "cpu_workers": 2,
    "blocking_threads": 2,
    "shared_blocking_limit": 2,
    "cpu_units": 8,
    "memory_units": 8
  },
  "classes": [
    {
      "name": "io",
      "slo_ms": 100,
      "max_inflight": 2,
      "max_queue_depth": 2,
      "cpu_units": 1,
      "memory_units": 1,
      "overflow": "queue_within_depth"
    }
  ],
  "template": {
    "class": "io",
    "path": "io",
    "body": {"kind": "async_sleep", "millis": 1}
  }
}
