{
  "schema_version": 1,
  "id": "h4-caller-affine-local-smoke-v1",
  "load": {
    "warmup_ms": 2,
    "injection_ms": 100,
    "interval_ms": 10,
    "snapshot_ms": 0,
    "settlement_ms": 500,
    "max_outstanding": 2,
    "max_records": 8
  },
  "topology": {
    "cpu_workers": 2,
    "blocking_threads": 2,
    "shared_blocking_limit": 2,
    "cpu_units": 8,
    "memory_units": 8
  },
  "classes": [
    {
      "name": "local",
      "slo_ms": 100,
      "max_inflight": 2,
      "max_queue_depth": 2,
      "cpu_units": 1,
      "memory_units": 1,
      "overflow": "queue_within_depth"
    }
  ],
  "offers": [
    {"send_time_ns": 0, "class": "local", "body": {"kind": "async_sleep", "millis": 2}},
    {"send_time_ns": 10000000, "class": "local", "body": {"kind": "noop"}}
  ]
}
