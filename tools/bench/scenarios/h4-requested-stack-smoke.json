{
  "schema_version": 1,
  "id": "h4-requested-stack-smoke-v1",
  "load": {
    "warmup_ms": 5,
    "injection_ms": 100,
    "interval_ms": 10,
    "snapshot_ms": 0,
    "settlement_ms": 500,
    "max_outstanding": 8,
    "max_records": 8
  },
  "topology": {
    "cpu_workers": 2,
    "blocking_threads": 2,
    "shared_blocking_limit": 2,
    "large_stack_slots": 2,
    "cpu_units": 8,
    "memory_units": 8
  },
  "classes": [
    {
      "name": "stack",
      "slo_ms": 100,
      "max_inflight": 2,
      "max_queue_depth": 2,
      "cpu_units": 1,
      "memory_units": 1,
      "overflow": "queue_within_depth"
    }
  ],
  "offers": [
    {
      "send_time_ns": 0,
      "class": "stack",
      "path": "requested_stack_blocking",
      "stack_size_bytes": 2097152,
      "body": { "kind": "blocking_sleep", "millis": 1 }
    },
    {
      "send_time_ns": 10000000,
      "class": "stack",
      "path": "requested_stack_async",
      "stack_size_bytes": 2097152,
      "body": { "kind": "async_sleep", "millis": 1 }
    }
  ]
}
