{
  "schema_version": 1,
  "id": "h5-custody-smoke-v1",
  "load": {
    "warmup_ms": 5,
    "injection_ms": 100,
    "interval_ms": 10,
    "snapshot_ms": 10,
    "settlement_ms": 500,
    "max_outstanding": 16,
    "max_records": 16
  },
  "topology": {
    "cpu_workers": 1,
    "blocking_threads": 1,
    "shared_blocking_limit": 1,
    "cpu_units": 1,
    "memory_units": 8
  },
  "classes": [
    {
      "name": "custody",
      "slo_ms": 100,
      "max_inflight": 1,
      "max_queue_depth": 4,
      "cpu_units": 1,
      "memory_units": 1,
      "overflow": "queue_within_depth"
    }
  ],
  "offers": [
    { "send_time_ns": 0, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 40 }, "drop_after_ms": 5 },
    { "send_time_ns": 1000000, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 5 }, "cancel_after_ms": 5 },
    { "send_time_ns": 2000000, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 5 }, "deadline_ms": 5 },
    { "send_time_ns": 3000000, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 5 }, "cancel_after_ms": 5 },
    { "send_time_ns": 4000000, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 5 }, "deadline_ms": 5 },
    { "send_time_ns": 50000000, "class": "custody", "path": "blocking", "body": { "kind": "blocking_sleep", "millis": 5 } }
  ]
}
