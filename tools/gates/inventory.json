      "id": "consumer-msrv",
      "recipe": "consumer-msrv",
      "tier": "matrix",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup toolchain = declared rust-version"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when the declared toolchain is not installed; CI installs it. The final `taskmesh-consumer-msrv status=PASS msrv=…` line is the verdict the receipt keeps",
      "status_line": {
        "marker": "taskmesh-consumer-msrv",
        "require": "status=PASS"
      }
    },
    {
      "id": "bench-iai",
      "recipe": "bench-iai",
      "tier": "proof",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "linux"
      ],
      "prerequisites": [
        "valgrind",
        "iai-callgrind-runner (version from tools/bench/perf-gate.json)"
      ],
      "workflow": "bench.yml",
      "conditional": "Linux only; the recipe prints `taskmesh-iai-gate status=…`. Only status=QUALIFIED is PASS: BASELINE_CREATED (first run for a fingerprint) is recorded as NOT_RUN — a baseline was written, nothing was compared",
      "status_line": {
        "marker": "taskmesh-iai-gate",
        "require": "status=QUALIFIED"
      }
    },
    {
      "id": "tsan",
      "recipe": "tsan",
      "tier": "proof",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup nightly toolchain with rust-src",
        "x86_64/aarch64 linux or macOS"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when nightly+rust-src are missing or the target is unsupported; CI installs them. Only `taskmesh-tsan status=CLEAN` is PASS; the line (with the target triple) is kept in the receipt",
      "note": "ThreadSanitizer on the real memory system (engine concurrency/effect/lifecycle tests, host chaos/executor/deadline/cancel tests). Complements loom/shuttle, which model interleavings.",
      "status_line": {
        "marker": "taskmesh-tsan",
        "require": "status=CLEAN"
      }
    },
    {
      "id": "fuzz",
      "recipe": "fuzz",
      "tier": "proof",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup nightly toolchain",
        "cargo-fuzz"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when nightly or cargo-fuzz is missing; CI installs them. Only `taskmesh-fuzz status=CLEAN` is PASS; the line (targets, seconds per target, total runs) is kept in the receipt",
      "note": "libFuzzer over the production Governor (every public transition, invariants after each step, quiescence at the end), the policy/topology/builder front doors, and the JSON wire formats. Complements the proptest differential model: coverage-guided rather than blind. FUZZ_SECONDS (default 30) bounds each target.",
      "status_line": {
        "marker": "taskmesh-fuzz",
        "require": "status=CLEAN"
      }
    },
    {
      "id": "coverage-report",
      "recipe": "coverage-report",
      "tier": "proof",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "cargo-llvm-cov"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when cargo-llvm-cov is missing; CI installs it. Only `taskmesh-coverage status=REPORTED …` is PASS; that line carries every available summary metric and explicitly marks uncollected branch/MCDC data",
      "note": "A report, not a threshold: the repository makes no coverage-gate promise. PASS means the report was produced. Lines, regions, functions and instantiations are recorded; zero-count branch/MCDC data is reported as NOT_COLLECTED, never as 0% coverage.",
      "status_line": {
        "marker": "taskmesh-coverage",
        "require": "status=REPORTED"
      }
    }
