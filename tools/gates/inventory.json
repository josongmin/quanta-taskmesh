    {
      "id": "mutants-critical",
      "recipe": "mutants-critical",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "uv (pytest for runner: pytest entries)",
        "just",
        "cargo",
        "clean CI source; runner uses an isolated source snapshot and dedicated target directory"
      ],
      "workflow": "ci.yml",
      "note": "Curated single-edit fault inventory, not an exhaustive cargo-mutants score. The receipt separates KILLED from CONTROL_GREEN and records cargo/pytest plus source-scope counts.",
      "producer": {
        "registration": "mutation-campaign-curated-v1",
        "manifest": "tools/verification/mutation-gate.json",
        "producer_id": "mutation-campaign",
        "version": "1",
        "surface": "curated",
        "hosted_job": "mutation-gate",
        "artifact_name": "mutation-curated-evidence",
        "artifact_download_path": "target/sep21/v02/curated",
        "required_configs": [
          "tools/verification/mutation-gate.json",
          "tools/verification/mutations.json"
        ],
        "summary": "target/sep21/v02/curated/receipt.mutations.json",
        "envelope": "target/sep21/v02/curated/evidence-envelope.json"
      }
    },
    {
      "id": "mutants-generated",
      "recipe": "mutants-generated",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "cargo-mutants",
        "cargo-nextest",
        "cargo",
        "one isolated target directory per campaign"
      ],
      "workflow": "ci.yml",
      "conditional": "The full generated denominator is required. Missing tooling is NOT_RUN; any missed, timeout, equivalent, subset, or incomplete identity set is FAIL. Compile-unviable identities are mandatory reported limitations excluded from the quality denominator.",
      "timeout_seconds": 18000,
      "note": "Generated cargo-mutants evidence is a distinct denominator and must never be merged with mutants-critical.",
      "producer": {
        "registration": "mutation-campaign-generated-v1",
        "manifest": "tools/verification/mutation-gate.json",
        "producer_id": "mutation-campaign",
        "version": "1",
        "surface": "generated",
        "hosted_job": "mutation-generated",
        "artifact_name": "mutation-generated-evidence",
        "artifact_download_path": "target/sep21/v02/generated",
        "required_configs": [
          "tools/verification/mutation-gate.json",
          ".cargo/mutants.toml"
        ],
        "summary": "target/sep21/v02/generated/receipt.generated-mutations.json",
        "envelope": "target/sep21/v02/generated/evidence-envelope.json"
      }
    },
    {
      "id": "modelcheck",
      "recipe": "modelcheck",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "cargo"
      ],
      "workflow": "ci.yml",
      "conditional": "Only the complete bounded Loom/Shuttle model set plus a separately generated and clean-process replayed failure is PASS.",
      "status_line": {
        "marker": "taskmesh-modelcheck",
        "require": "status=PASS"
      },
      "producer": {
        "registration": "taskmesh-modelcheck-v03",
        "manifest": "tools/modelcheck/producer-manifest.json",
        "producer_id": "taskmesh-modelcheck-v03",
        "version": "1",
        "surface": "modelcheck",
        "hosted_job": "modelcheck",
        "artifact_name": "modelcheck-evidence",
        "artifact_download_path": "target/modelcheck",
        "required_configs": [
          "tools/modelcheck/producer-manifest.json",
          "Cargo.lock",
          "crates/taskmesh-engine/tests/loom_governance.rs",
          "crates/taskmesh-engine/tests/shuttle_governance.rs",
          "crates/taskmesh-engine/tests/model_replay_fixture.rs"
        ],
        "summary": "target/modelcheck/model-receipt.json",
        "envelope": "target/modelcheck/evidence-envelope.json"
      }
    },
    {
      "id": "consumer-msrv",
      "recipe": "consumer-msrv",
      "tier": "matrix",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup toolchain = declared rust-version"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when the declared toolchain is not installed; local qualification requires it. The final `taskmesh-consumer-msrv status=PASS msrv=…` line is the verdict the receipt keeps",
      "status_line": {
        "marker": "taskmesh-consumer-msrv",
        "require": "status=PASS"
      }
    },
    {
      "id": "bench-iai",
      "recipe": "bench-iai",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "linux"
      ],
      "prerequisites": [
        "valgrind",
        "iai-callgrind-runner (version from tools/bench/perf-gate.json)"
      ],
      "workflow": "bench.yml",
      "conditional": "Linux only; the recipe prints `taskmesh-iai-gate status=…`. Only status=QUALIFIED is PASS: BASELINE_CREATED (first run for a fingerprint) is recorded as NOT_RUN — a baseline was written, nothing was compared",
      "status_line": {
        "marker": "taskmesh-iai-gate",
        "require": "status=QUALIFIED"
      }
    },
    {
      "id": "tsan",
      "recipe": "tsan",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup nightly toolchain with rust-src",
        "x86_64/aarch64 linux or macOS"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when nightly+rust-src are missing or the target is unsupported; local qualification requires them. Only `taskmesh-tsan status=CLEAN` is PASS; the line (with the target triple) is kept in the receipt",
      "note": "ThreadSanitizer on the real memory system (engine concurrency/effect/lifecycle tests, host chaos/executor/deadline/cancel tests). Complements loom/shuttle, which model interleavings.",
      "status_line": {
        "marker": "taskmesh-tsan",
        "require": "status=CLEAN"
      }
    },
    {
      "id": "fuzz",
      "recipe": "fuzz",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup nightly toolchain",
        "cargo-fuzz"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when nightly or cargo-fuzz is missing; local qualification requires them. Only `taskmesh-fuzz status=PASS` with all semantic witnesses is PASS",
      "note": "libFuzzer over the production Governor (every public transition, invariants after each step, quiescence at the end), the policy/topology/builder front doors, and the JSON wire formats. Complements the proptest differential model: coverage-guided rather than blind. FUZZ_SECONDS (default 30) bounds each target.",
      "status_line": {
        "marker": "taskmesh-fuzz",
        "require": "status=PASS"
      },
      "producer": {
        "registration": "taskmesh-fuzz-v03",
        "manifest": "tools/fuzz/producer-manifest.json",
        "producer_id": "taskmesh-fuzz-v03",
        "version": "1",
        "surface": "fuzz",
        "hosted_job": "fuzz",
        "artifact_name": "fuzz-artifacts",
        "artifact_download_path": ".",
        "required_configs": [
          "tools/fuzz/producer-manifest.json",
          "fuzz/corpus-manifest.json"
        ],
        "summary": "target/sep21/v03/fuzz/local/fuzz-receipt.json",
        "envelope": "target/sep21/v03/fuzz/local/evidence-envelope.json"
      }
    },
    {
      "id": "coverage-report",
      "recipe": "coverage-report",
      "tier": "nightly",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "cargo-llvm-cov"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when cargo-llvm-cov is missing; local qualification requires it. Only `taskmesh-coverage status=REPORTED …` is PASS; that line carries every available summary metric and explicitly marks uncollected branch/MCDC data",
      "note": "A report, not a threshold: the repository makes no coverage-gate promise. PASS means the report was produced. Lines, regions, functions and instantiations are recorded; zero-count branch/MCDC data is reported as NOT_COLLECTED, never as 0% coverage.",
      "status_line": {
        "marker": "taskmesh-coverage",
        "require": "status=REPORTED"
      }
    }
  ]
}
