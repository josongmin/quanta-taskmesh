      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when cargo-llvm-cov is missing; CI installs it",
      "note": "A report, not a threshold: the repository makes no coverage-gate promise. PASS means the report was produced; the percentages are recorded for review."
