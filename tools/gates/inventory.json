    },
    {
      "id": "tsan",
      "recipe": "tsan",
      "tier": "proof",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustup nightly toolchain with rust-src",
        "x86_64/aarch64 linux or macOS"
      ],
      "workflow": "ci.yml",
      "conditional": "reports NOT_RUN (exit 2) when nightly+rust-src are missing or the target is unsupported; CI installs them",
      "note": "ThreadSanitizer on the real memory system (engine concurrency/effect/lifecycle tests, host chaos/executor/deadline/cancel tests). Complements loom/shuttle, which model interleavings."
    },
