{
  "schema_version": 1,
  "description": "Every verification gate this repository runs, keyed by a stable id. The Justfile is the single definition of each command; this file records where each gate runs, what it needs, and approved bounded local parallel groups. Required-ness lives in required.json, on purpose a separate file.",
  "qualification_budget_seconds": 18000,
  "gates": [
    {
      "id": "semver-release",
      "recipe": "semver-release",
      "tier": "release",
      "runs_in": ["local", "ci"],
      "platforms": ["any"],
      "prerequisites": ["cargo-semver-checks 0.50.0", "immutable baseline commit"],
      "workflow": "release.yml",
      "note": "Release-only four-crate compatibility audit. Its PASS is not a release verdict; the release receipt additionally requires the ordinary exact-source local receipt and manual facade/wire/behavior adjudication."
    },
    {
      "id": "fmt-check",
      "recipe": "fmt-check",
      "tier": "fast",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "rustfmt"
      ],
      "workflow": "ci.yml",
      "parallel_group": "static-independent"
    },
    {
      "id": "clippy",
      "recipe": "clippy",
      "tier": "fast",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [
        "clippy",
        "config/clippy-*.txt"
      ],
      "workflow": "ci.yml"
    },
    {
      "id": "test",
      "recipe": "test",
      "tier": "fast",
      "runs_in": [
        "local",
        "ci"
      ],
      "platforms": [
        "any"
      ],
      "prerequisites": [],
