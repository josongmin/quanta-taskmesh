{
  "schema_version": 1,
  "description": "The gates a source revision must pass to be qualified. Authored independently of inventory.json so that deleting a gate from the inventory does not delete the requirement — the validator reports the mismatch instead.",
  "required": [
    "fmt-check",
    "gates-inventory",
    "py-lint",
    "test-architecture",
    "semgrep",
    "deny",
    "clippy",
    "test",
    "py-test",
    "bench-gate",
    "fuzz-check",
    "test-rayon",
    "doctest",
    "rustdoc",
    "bench-smoke",
    "consumer-msrv",
    "bench-iai",
    "mutants-critical",
    "modelcheck",
    "tsan",
    "fuzz",
    "coverage-report",
    "mutants-generated"
  ],
  "required_producers": {
    "mutation-campaign-curated-v1": "mutants-critical",
    "mutation-campaign-generated-v1": "mutants-generated",
    "taskmesh-fuzz-v03": "fuzz",
    "taskmesh-modelcheck-v03": "modelcheck"
  },
  "platform_conditional": {
    "bench-iai": "linux",
    "consumer-msrv": "declared-toolchain-installed",
    "tsan": "nightly-toolchain-with-rust-src",
    "coverage-report": "cargo-llvm-cov-installed",
    "fuzz": "nightly-toolchain-with-cargo-fuzz",
    "mutants-generated": "cargo-mutants-and-nextest-installed"
  }
}
