{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskmesh.dev/schemas/evidence-envelope-v1.schema.json",
  "title": "EvidenceEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "producer", "source", "command", "tools", "configs", "action", "artifacts", "result"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "taskmesh-evidence-envelope"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["head", "tree_digest", "dirty"], "properties": {"head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree_digest": {"$ref": "#/$defs/sha256"}, "dirty": {"type": "boolean"}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["argv", "cwd", "environment", "sha256"], "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"type": "string", "minLength": 1}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "tools": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "identity_sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^(?=.*[0-9])(?!stable$|latest$|nightly$|master$|main$|head$).+$"}, "identity_sha256": {"$ref": "#/$defs/sha256"}}}},
    "configs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/safe_path"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["context", "workflow", "workflow_ref", "workflow_sha256", "source_sha", "job", "event", "actions"], "properties": {"context": {"enum": ["local", "github-actions"]}, "workflow": {"$ref": "#/$defs/safe_path"}, "workflow_ref": {"type": "string", "minLength": 1}, "workflow_sha256": {"$ref": "#/$defs/sha256"}, "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "job": {"type": "string", "minLength": 1}, "event": {"type": "string", "minLength": 1}, "actions": {"type": "array", "items": {"type": "string", "pattern": "^[^\\s@]+@[0-9a-f]{40}$"}}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "role"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}, "role": {"enum": ["raw", "summary", "replay", "diagnostic"]}}}},
    "result": {"type": "object", "additionalProperties": false, "$comment": "The Python semantic validator additionally requires finished_at >= started_at.", "required": ["status", "exit_code", "started_at", "finished_at", "selected_count", "executed_count"], "properties": {"status": {"enum": ["PASS", "FAIL", "NOT_RUN", "SKIPPED", "TIMEOUT", "BASELINE_CREATED"]}, "exit_code": {"type": ["integer", "null"]}, "started_at": {"$ref": "#/$defs/utc_timestamp"}, "finished_at": {"$ref": "#/$defs/utc_timestamp"}, "selected_count": {"type": "integer", "minimum": 0}, "executed_count": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "utc_timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"}
  }
}
