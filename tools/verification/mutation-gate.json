{
  "schema_version": 1,
  "producer": "mutation-campaign",
  "source_policy": "isolated-current-source-snapshot",
  "target_policy": "dedicated-per-campaign",
  "curated": {
    "command": ["uv", "run", "python", "tools/verification/run_mutations.py"],
    "summary_artifact": "receipt.mutations.json",
    "baseline_artifact": "mutation-baseline-manifest.json",
    "raw_artifact_glob": "raw/*.log",
    "pass_statuses": ["KILLED", "CONTROL_GREEN"],
    "selected_equals_executed": true,
    "manifest_path_policy": "normalized-repo-relative-no-symlink-escape",
    "runner_environment_is_authoritative": true
  },
  "generated": {
    "command": ["uv", "run", "python", "tools/verification/run_generated_mutants.py", "--jobs", "1"],
    "summary_artifact": "receipt.generated-mutations.json",
    "raw_artifact_glob": "raw/mutants.out/**",
    "required_categories": ["caught", "missed", "unviable", "timeout", "equivalent"],
    "identity_sets": "planned-equals-categorized-equals-executed",
    "pass_requires": {
      "exit_code": 0,
      "signal": null,
      "timed_out": false,
      "missed": 0,
      "unviable": 0,
      "timeout": 0,
      "equivalent": 0
    }
  },
  "evidence_envelope": {
    "schema": "tools/qualification/evidence-envelope-v1.schema.json",
    "producer_id": "mutation-campaign",
    "required_artifact_roles": ["raw", "summary"]
  }
}
